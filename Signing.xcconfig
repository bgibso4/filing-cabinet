// Signing identity and bundle id.
//
// FilingCabinet.xcodeproj is GENERATED by XcodeGen and gitignored, so changes made in
// Xcode's "Signing & Capabilities" tab are lost on regeneration. Set values here instead.
//
// To sign with another team, create a gitignored `Signing.local.xcconfig` next to this file:
//
//     DEVELOPMENT_TEAM = XXXXXXXXXX
//     APP_BUNDLE_ID = com.example.filingcabinet
//
// DEVELOPMENT_TEAM and APP_BUNDLE_ID must NOT be set in project.yml `settings`: target
// settings outrank an xcconfig and would silently defeat the override.

DEVELOPMENT_TEAM = W6S6K84XVM
APP_BUNDLE_ID = com.cadre.filingcabinet

// Optional per-developer override; `?` means no error if absent.
#include? "Signing.local.xcconfig"
