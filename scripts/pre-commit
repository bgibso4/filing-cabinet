#!/bin/bash
# Installed by `make setup`. Format check, lint, then flag changed snapshot references.
set -eu
cd "$(git rev-parse --show-toplevel)"
make --no-print-directory lint
changed="$(scripts/changed-snapshots.sh --cached)"
if [ -n "$changed" ]; then
    echo "Changed snapshot references — name each in the commit message with the reason:"
    echo "$changed" | sed 's/^/  /'
fi
